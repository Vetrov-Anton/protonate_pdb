#!/usr/bin/env bash
# Run protprep without installing it: use the local .venv if present,
# otherwise the system python (which then needs pdb2pqr/propka/numpy).
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -x "$here/.venv/bin/python" ]]; then
    py="$here/.venv/bin/python"
else
    py="$(command -v python3)"
fi
exec "$py" -c "import sys; sys.path.insert(0, '$here'); from protprep.cli import main; sys.exit(main())" "$@"
